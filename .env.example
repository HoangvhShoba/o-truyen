# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# ===========================================
# MongoDB Configuration
# ===========================================
MONGODB_URI=mongodb://localhost:27017/api_truyen
MONGODB_URI_PRODUCTION=

# ===========================================
# JWT Configuration
# ===========================================
JWT_ACCESS_SECRET=your_access_token_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFY_EMAIL_EXPIRES_IN=24h
JWT_RESET_PASSWORD_EXPIRES_IN=1h

# ===========================================
# Redis Configuration (Optional)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
USE_REDIS_CACHE=false

# ===========================================
# Cloudinary Configuration (Optional)
# ===========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=api-truyen

# ===========================================
# Email Configuration
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hoangclhd@gmail.com
SMTP_PASS=672002Hoang@
EMAIL_FROM=hoangclhd@api-truyen.com
EMAIL_FROM_NAME=API Truyen

# ===========================================
# OTruyen API Configuration
# ===========================================
OTRUYEN_BASE_URL=https://otruyen.cc/api
OTRUYEN_API_KEY=

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX_REQUESTS=30

# ===========================================
# File Upload
# ===========================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=*

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ===========================================
# Swagger Documentation
# ===========================================
SWAGGER_TITLE=API Truyen Documentation
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=Backend API cho web đọc truyện
SWAGGER_API_URL=/api-docs
