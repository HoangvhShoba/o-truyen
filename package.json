{
  "name": "api-truyen",
  "version": "1.0.0",
  "description": "Backend API cho web đọc truyện - Node.js, Express.js, MongoDB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "node src/scripts/seed.js",
    "sync": "node src/scripts/sync.js"
  },
  "keywords": [
    "api",
